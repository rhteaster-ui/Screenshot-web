# Standalone Node HTTP listener
PORT=3000
# Set your exact public origin when behind an HTTPS reverse proxy
APP_ORIGIN=
# Standalone: playwright. Sites: remote, with your own HTTPS capture engine.
CAPTURE_PROVIDER=playwright
CAPTURE_ENGINE_URL=
# Shared secret for the optional /api/engine endpoint; never expose in frontend.
CAPTURE_ENGINE_TOKEN=
# Keep enabled in production. Docker must allow Chromium user namespaces.
CHROMIUM_SANDBOX=true
# Optional existing compatible Chromium binary; empty uses Playwright's browser.
CHROMIUM_EXECUTABLE_PATH=
CAPTURE_TIMEOUT=90000
CAPTURE_FILE_TTL=1800000
CAPTURE_BATCH_LIMIT=5
CAPTURE_MAX_OUTPUT_BYTES=8388608
CAPTURE_RATE_LIMIT=10
CAPTURE_MAX_CONCURRENT=2
